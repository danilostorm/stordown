{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StorDown",
  "version": "0.1.0-alpha.2",
  "identifier": "cloud.hoststorm.stordown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StorDown",
        "width": 1180,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Gerenciador de downloads e uploads Multi-WAN",
    "longDescription": "StorDown combina múltiplas conexões de Internet em downloads segmentados, integra Google Drive e oferece upload acelerado via StorDown Relay.",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../target/release/stordown-native-host.exe": "stordown-native-host.exe",
      "../../../browser-extension/": "browser-extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
