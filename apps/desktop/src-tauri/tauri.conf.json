{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StorDown",
  "version": "0.1.0",
  "identifier": "cloud.hoststorm.stordown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StorDown",
        "width": 1180,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
